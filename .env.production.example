# Copy to .env on the server, then run: php artisan key:generate
APP_NAME="Jueli Engineering Ltd"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.your-domain.co.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Only when the site sits behind a proxy/CDN you control (e.g. Cloudflare): TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# First admin login created by "php artisan db:seed". Leave ADMIN_PASSWORD empty to have a
# strong random one generated and printed once in the terminal.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@your-domain.co.ke
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12
